# UniShare environment variables.
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to version control.

# Flask secret key — used for session signing and CSRF tokens.
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-secret

# Optional: override the default SQLite database location.
# Default is sqlite:///<project_root>/app.db (see app/config.py).
# DATABASE_URL=sqlite:///path/to/your/database.db
